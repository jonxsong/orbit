# API service
DATABASE_URL=postgres://orbit:orbit@localhost:5432/orbit?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info
ORBIT_ENV=development
ORBIT_DEV_USER_ID=00000000-0000-4000-8000-000000000001

# OIDC (required outside local development)
OIDC_ISSUER_URL=
OIDC_AUDIENCE=

# Server-side AI only. Never expose this variable through Expo public config.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Mobile public configuration
EXPO_PUBLIC_API_URL=http://localhost:8080

# Canonical public website
ORBIT_PUBLIC_SITE_URL=https://orbit.jonzhang.dev

